# Free AI chat assistant — get a free key at https://aistudio.google.com/apikey
# (without it the widget answers from built-in FAQs, also free)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Where contact-form leads are emailed
CONTACT_TO_EMAIL=thezainasolutions@gmail.com

# Email delivery — set ONE of these.
# Web3Forms (easiest, free, no account): get a key at https://web3forms.com
WEB3FORMS_ACCESS_KEY=
# Resend (https://resend.com — free tier) as an alternative
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Zaina Website <onboarding@resend.dev>

# Optional extra lead channel (Slack/Discord/Make webhook)
CONTACT_WEBHOOK_URL=

# Override the WhatsApp link used by the chat widget (e.g. a community invite)
NEXT_PUBLIC_WHATSAPP_URL=
